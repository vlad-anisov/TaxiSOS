<?xml version="1.0" encoding="utf-8"?>
<manifest package="com.example.sostaxi" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Необходимые разрешения -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Для фоновой работы с локацией на Android 10+ (опционально) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Разрешение на запуск Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Разрешение на использование интернета для отправки видео -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Разрешения для RTMP трансляции -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Добавляем необходимые разрешения для StreamPack -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Разрешения для Telegram авторизации -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    
    <!-- Дополнительные разрешения для TDLib -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    
    <!-- Разрешение для Bluetooth Button Service (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- BLE permissions (scoped by SDK level) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Для сканирования BLE на Android <= 11 используется геолокация (уже есть ACCESS_FINE_LOCATION) -->

    <!-- BLE feature -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    


    <!-- Объявляем характеристики камеры для Google Play Store -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />


    <application android:allowBackup="true"
        android:name=".SOSTaxiApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:debuggable="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppTheme"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        targetApi="31">
    <!-- Активность приложения -->
        <activity android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>



        <!-- Foreground-сервис для записи видео (камера, микрофон, локация) -->
        <service android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone|location" />

        <!-- Quick Settings Tiles -->
        <service
            android:name=".StreamingTileService"
            android:icon="@android:drawable/ic_media_play"
            android:label="@string/tile_streaming"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".VideoSegmentsTileService"
            android:icon="@android:drawable/ic_menu_camera"
            android:label="@string/tile_video_segments"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Bluetooth Button Service для обработки нажатий в фоне -->
        <service
            android:name=".BluetoothButtonService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- MediaButtonReceiver для перехвата медиа-событий от Bluetooth-кнопок -->
        <receiver
            android:name=".MediaButtonReceiver"
            android:exported="true">
            <intent-filter android:priority="2147483647">
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Accessibility Service для перехвата кнопок громкости (для дешевых Bluetooth-кнопок) -->
        <service
            android:name=".VolumeButtonAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Activity выбора BLE-устройства -->
        <activity
            android:name=".BleDevicePickerActivity"
            android:exported="false"
            android:label="Выбор BLE-устройства" />

        <!-- Ресивер для подключения/отключения выбранного BT-устройства -->
        <receiver android:name=".BluetoothReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>

